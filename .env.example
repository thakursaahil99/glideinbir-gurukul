LIVEKIT_API_SECRET=
RESEND_API_KEY=                   # without it, emails are only logged in dev
EMAIL_FROM=                       # e.g. Glideinbir Gurukul <hello@yourdomain.com>
JUDGE0_API_KEY=
JUDGE0_HOST=
CODE_LOCAL_RUNNER=                # 1 = allow the local JavaScript runner in production (it can reach the network)
ADZUNA_APP_ID=                    # free at developer.adzuna.com: live jobs across every Indian city
ADZUNA_APP_KEY=                   # server only
GEMINI_API_KEY=                   # optional
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=                      # server only; scheduled jobs call /api/cron/* with "Authorization: Bearer <it>"

